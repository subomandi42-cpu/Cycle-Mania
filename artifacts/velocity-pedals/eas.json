{
  "cli": {
    "version": ">= 13.1.1",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "image": "ubuntu-22.04-jdk-17-ndk-r25b",
      "distribution": "internal",
      "channel": "preview",
      "node": "20.18.0",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      }
    }
  }
}

      

    
  
  
    
